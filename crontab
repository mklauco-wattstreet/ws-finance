# Python Cron Jobs
# Format: minute hour day month weekday command
# All times in container timezone (set in docker-compose.yml)
#
# Scripts run in AUTO mode (no arguments) and automatically:
# - Find the last downloaded file
# - Download all missing files from last download date + 1 to yesterday
# - If no files exist, download last 7 days

# ============================================================================
# OTE-CR - Czech Market Data
# ============================================================================

# OTE-CR - Download day-ahead prices every 10 min from 14:00-21:59 (published ~14:00).
# Self-stops via on-disk guard once tomorrow's file has landed + uploaded.
2,12,22,32,42,52 14-21 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app/scripts && /usr/local/bin/python3 download_day_ahead_prices.py >> /var/log/ote.log 2>&1

# OTE-CR - Download day-ahead 60min prices every 10 min from 14:00-21:59 (published ~14:00).
# Self-stops via on-disk guard once tomorrow's file has landed + uploaded.
2,12,22,32,42,52 14-21 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app/scripts && /usr/local/bin/python3 download_day_ahead_60min_prices.py >> /var/log/ote.log 2>&1

# OTE-CR - Download imbalance prices every 2 hours
0 */2 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app/scripts && /usr/local/bin/python3 download_imbalance_prices.py >> /var/log/ote.log 2>&1

# Trader - Liquidate expired positions 15 min after imbalance prices fetch
15 */2 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.liquidate_expired_positions_runner >> /var/log/liquidator.log 2>&1

# OTE-CR - Download intraday prices every 15 minutes
*/15 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app/scripts && /usr/local/bin/python3 download_intraday_prices.py >> /var/log/ote.log 2>&1

# OKTE-SK - Download Slovak intraday market (IDM) reports every 15 minutes.
# One request returns a zip with both order books (15-min + hourly product).
# Auto mode re-fetches a trailing 3 days, not just today: periods appear as they
# trade AND a container outage would otherwise leave a permanent hole, since
# nothing else ever revisits a past day. Same single request either way.
# Offset to 14,29,44,59 so rows land before the downstream consumer at 1,16,31,46.
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app/scripts && /usr/local/bin/python3 download_okte_idm.py >> /var/log/okte.log 2>&1

# OKTE-SK - Imbalance settlement (regulardaily) twice daily.
# NOT a real-time feed: regulardaily is published at D+2, so a 15-min cadence
# would poll hundreds of times for one daily change. Trailing 7-day window
# (--days default) so the D+2 vintage always lands even after a short outage.
14 07,19 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app/scripts && /usr/local/bin/python3 download_okte_imbalance.py >> /var/log/okte.log 2>&1

# OKTE-SK - Intraday Auction (IDA1/IDA2/IDA3) prices, Europe/Prague times below.
# IDA1 results publish ~15:12 D-1, IDA2 ~22:12 D-1, IDA3 ~10:12 D. Each auction
# gets its hour plus a retry hour an hour later; a single fetch covers all three
# auctions for whatever is available. Minute 20 lands well after the ~hh:12
# publication and clear of the 14,29,44,59 pipeline slots.
20 10,11,15,16,22,23 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app/scripts && /usr/local/bin/python3 download_okte_ida.py >> /var/log/okte_ida.log 2>&1

# OTE-CR - Download OTE daily settlement reports at 09:00
0 09 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app/scripts && /usr/local/bin/python3 ote_production.py >> /var/log/ote.log 2>&1

# OTE-CR - Download OTE trade balance reports every 2 hours (offset to minute 10)
10 */2 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app/scripts && /usr/local/bin/python3 ote_trade_balance_downloader.py >> /var/log/ote.log 2>&1

# OTE-CR - Download DAM matching curves every 10 min from 14:00-21:59 (published ~14:00).
# Chains upload + backfill_da_60min in the same run so da_period_summary/curve_depth
# and their _60min aggregates land seconds after the source. Self-stops once
# tomorrow's da_period_summary_60min rows exist (self-verifying guard).
2,12,22,32,42,52 14-21 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app/scripts && /usr/local/bin/python3 download_dam_curves.py >> /var/log/ote.log 2>&1

# OTE-CR - Download IDA1 intraday auction prices (placeholder schedule)
0 11,13,15 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app/scripts && /usr/local/bin/python3 download_ida_prices.py --ida 1 >> /var/log/ote.log 2>&1

# OTE-CR - Download IDA2 intraday auction prices (placeholder schedule)
0 15,17,19 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app/scripts && /usr/local/bin/python3 download_ida_prices.py --ida 2 >> /var/log/ote.log 2>&1

# OTE-CR - Download IDA3 intraday auction prices (placeholder schedule)
0 19,21,23 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app/scripts && /usr/local/bin/python3 download_ida_prices.py --ida 3 >> /var/log/ote.log 2>&1

# ============================================================================
# CEPS - Czech Grid Imbalance Data (via SOAP API)
# ============================================================================

# CEPS - Download and upload ALL datasets EXCEPT imbalance (RE price, SVR activation, export/import SVR, generation)
# Runs at minutes 14, 29, 44, 59 every hour — data ready before consumer at :01,:16,:31,:46
# Uses SOAP API - completes in ~7 seconds (50-100x faster than Selenium)
# imbalance is intentionally excluded here — it has its own 5-min job below. Do NOT
# re-add it to this "all" run, or it will double-fetch at :14/:29/:44/:59 and risk
# tripping the CEPS API's rate limiting.
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m ceps.ceps_soap_pipeline --dataset all >> /var/log/ceps.log 2>&1

# CEPS - System imbalance (ceps_actual_imbalance_1min) every 5 minutes — higher-frequency
# signal, single lightweight SOAP call. All other CEPS/ENTSO-E/OTE data stays at 15min;
# do NOT add other datasets to this cadence or we risk blocking the CEPS API.
*/5 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m ceps.ceps_soap_pipeline --dataset imbalance >> /var/log/ceps_imbalance.log 2>&1

# ============================================================================
# ENTSO-E - Pan-European Data Pipelines (separate logs per runner)
# ============================================================================

# ENTSO-E Group 1 - minutes 14,29,44,59 (core real-time data)
# ENTSO-E - Unified imbalance data pipeline every 15 minutes
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_unified_imbalance_runner >> /var/log/entsoe_imbalance.log 2>&1

# ENTSO-E - Unified load data pipeline every 15 minutes
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_unified_load_runner >> /var/log/entsoe_load.log 2>&1

# ENTSO-E - Unified generation data pipeline every 15 minutes
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_unified_gen_runner >> /var/log/entsoe_gen.log 2>&1

# ENTSO-E Group 2 - minutes 14,29,44,59 (flows and forecasts)
# ENTSO-E - Unified cross-border flows pipeline every 15 minutes
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_unified_flow_runner >> /var/log/entsoe_flow.log 2>&1

# ENTSO-E - DA generation forecast (A01) every 15 min (checks DB, fetches TOMORROW ~15:00 CET)
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_unified_forecast_runner >> /var/log/entsoe_forecast.log 2>&1

# ENTSO-E - Intraday generation forecast (A40) every 15 min (checks DB, fetches TODAY ~09:00 CET)
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_unified_forecast_intraday_runner >> /var/log/entsoe_forecast_intraday.log 2>&1

# ENTSO-E Group 3 - minutes 14,29,44,59 (forecasts, balancing, scheduled)
# ENTSO-E - Current generation forecast (A18) every 15 min (continuous)
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_unified_forecast_current_runner >> /var/log/entsoe_forecast_current.log 2>&1

# ENTSO-E - Unified balancing energy pipeline every 15 minutes
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_unified_balancing_runner >> /var/log/entsoe_balancing.log 2>&1

# ENTSO-E - Unified scheduled generation pipeline every 15 minutes
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_unified_scheduled_runner >> /var/log/entsoe_scheduled.log 2>&1

# ENTSO-E - Unified scheduled cross-border flows pipeline every 15 minutes
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_unified_sched_flow_runner >> /var/log/entsoe_sched_flow.log 2>&1

# ENTSO-E - Outages (A77 planned + A80 forced unavailability, CZ) every 15 min
# Update-window poll catches new + revised + cancelled/withdrawn outages; rebuilds 15min/60min aggregates for [D-3,D+2]
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_outages_runner >> /var/log/entsoe_outages.log 2>&1

# ENTSO-E - Procured Balancing Capacity (12.3.F, CZ aFRR+mFRR) 4x/day at :14
# Daily day-ahead auction; runner self-aggregates raw/60min/15min for [D-1,D+1]
14 8,12,16,20 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_procured_capacity_runner >> /var/log/entsoe_procured_capacity.log 2>&1

# ENTSO-E - Unified day-ahead prices every 15min from 14:00-20:59 (published ~13:00, retry on failure)
2,17,32,47 14-20 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_unified_day_ahead_prices_runner >> /var/log/entsoe_day_ahead.log 2>&1

# ENTSO-E - Intraday transfer capacity (12.1.A/B, A31) CZ borders, window D..D+1
# IDCT (auction.Type=A08) is REVISED continuously through the delivery day -> always re-fetch, never skipped.
# 8 border-directions x 2 days = 16 requests per firing.
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_intraday_capacity_runner --products idct >> /var/log/entsoe_id_capacity_idct.log 2>&1

# IDA1/IDA2/IDA3 publish once per day each (IDA1 ~15:00 D-1, IDA2 ~22:00 D-1, IDA3 ~10:00 D; IDA3 covers
# only 12:00-24:00). Poll every 5 min inside those windows so the data lands ASAP; the runner runs one
# completeness SELECT per product first and skips the 8 HTTP calls entirely once a product+day is complete.
*/5 9-11,14-17,21-23 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_intraday_capacity_runner --products ida1,ida2,ida3 >> /var/log/entsoe_id_capacity_ida.log 2>&1

# Hourly catch-up for a delayed/failed IDA publication outside the windows above. The IDA default window
# reaches back 10 days and the completeness SELECT skips whole days, so this costs no API traffic when the
# history is already filled.
44 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_intraday_capacity_runner --products ida1,ida2,ida3 >> /var/log/entsoe_id_capacity_ida.log 2>&1

# ENTSO-E - Congestion income (12.1.E, A25/B10) CZ bidding zone, window D-2..D, 1 request per firing.
# Values keep filling in through the delivery day and late corrections happen, so the whole window is
# always re-fetched; skip_unchanged on the upsert keeps updated_at honest.
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.entsoe_congestion_income_runner >> /var/log/entsoe_congestion_income.log 2>&1

# ============================================================================
# CNB - Czech National Bank Exchange Rate
# ============================================================================

# CNB - CZK/EUR exchange rate every 2h from 15:00-21:00 weekdays (published ~14:30, retry on failure)
0 15,17,19,21 * * 1-5 export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.cnb_exchange_rate_runner >> /var/log/cnb_fx.log 2>&1

# ============================================================================
# Weather - Open-Meteo (Central Czechia lat=49.80, lon=15.47)
# ============================================================================

# Weather: D+1 forecast — once daily at 15:14 Prague time (after 12z model run ~14:00 CEST)
14 15 * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.weather_forecast_runner >> /var/log/weather_forecast.log 2>&1

# Weather: current conditions snapshot — every 15 min at :14,:29,:44,:59 (aligned with other pipelines)
14,29,44,59 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m runners.weather_current_runner >> /var/log/weather_current.log 2>&1

# ============================================================================
# 60-min aggregators — fire 1 min after the 15-min source runners (:14,:29,:44,:59)
# Each runs in --auto mode (trailing 6 hours). HOUR_COMPLETE_HAVING (in
# backfill/_common.py) gates partial hours, so empty firings are normal.
# ============================================================================

15,30,45,0 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m backfill.backfill_da_60min --auto >> /var/log/aggregator_da_60min.log 2>&1
15,30,45,0 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m backfill.backfill_ida_60min --auto >> /var/log/aggregator_ida_60min.log 2>&1
15,30,45,0 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m backfill.backfill_weather_60min --auto >> /var/log/aggregator_weather_60min.log 2>&1
15,30,45,0 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m backfill.backfill_ceps_60min --auto >> /var/log/aggregator_ceps_60min.log 2>&1
15,30,45,0 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m backfill.backfill_ceps_1min_features_60min --auto >> /var/log/aggregator_ceps_1min_features_60min.log 2>&1
15,30,45,0 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m backfill.backfill_entsoe_60min --auto >> /var/log/aggregator_entsoe_60min.log 2>&1
15,30,45,0 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m backfill.backfill_okte_ida_60min --auto >> /var/log/aggregator_okte_ida_60min.log 2>&1
# OTE imbalance settlement data is published with a multi-day lag, so a 6h --auto
# window misses late-arriving days. Look back 14 days (idempotent re-aggregation).
15,30,45,0 * * * * export $(cat /etc/environment_for_cron | xargs) && cd /app && /usr/local/bin/python3 -m backfill.backfill_ote_imbalance_60min --auto --auto-days 14 >> /var/log/aggregator_ote_imbalance_60min.log 2>&1

# ============================================================================
# Cleanup - Delete old downloaded files daily at 02:00
# ============================================================================

# ENTSO-E XML files - keep 1 day
0 02 * * * find /app/downloads/entsoe -type f -name "*.xml" -mtime +1 -delete 2>/dev/null

# CEPS files (CSV + XML) - keep 1 day
5 02 * * * find /app/downloads/ceps -type f \( -name "*.xml" -o -name "*.csv" \) -mtime +1 -delete 2>/dev/null

# OTE files - keep 7 days
10 02 * * * find /app/ote_files -type f -mtime +7 -delete 2>/dev/null

# OTE IDA Excel files - keep 7 days
15 02 * * * find /app/scripts/IDA1 /app/scripts/IDA2 /app/scripts/IDA3 -type f -name "*.xlsx" -mtime +7 -delete 2>/dev/null

# ============================================================================
# Log rotation - Keep only last 96 hours (4 days) of logs
# ============================================================================

# Rotate all logs daily at 03:00 - keep last 10000 lines (~4 days of logs)
0 03 * * * for f in /var/log/ote.log /var/log/ceps.log /var/log/ceps_imbalance.log /var/log/entsoe_*.log /var/log/cnb_fx.log /var/log/weather_*.log /var/log/liquidator.log /var/log/okte_ida.log /var/log/aggregator_*.log; do [ -f "$f" ] && tail -10000 "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done 2>/dev/null

# Empty line required at end of crontab file
