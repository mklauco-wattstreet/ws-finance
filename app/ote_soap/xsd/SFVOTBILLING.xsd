																	<xs:documentation xml:lang="EN">The electricity tax</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="origEtaxEur" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Daň z elektřiny</xs:documentation>
																	<xs:documentation xml:lang="EN">The electricity tax</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="origVatCzk" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">DPH</xs:documentation>
																	<xs:documentation xml:lang="EN">VAT</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="origVatEur" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">DPH</xs:documentation>
																	<xs:documentation xml:lang="EN">VAT</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="paymentCzk" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Platba</xs:documentation>
																	<xs:documentation xml:lang="EN">Payment</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="paymentEur" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Platba</xs:documentation>
																	<xs:documentation xml:lang="EN">Payment</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="tradeDate" type="xs:date" use="required">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Datum obchodu</xs:documentation>
																	<xs:documentation xml:lang="EN">Trade date</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="valueDate" type="xs:date">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Datum splatnosti</xs:documentation>
																	<xs:documentation xml:lang="EN">Value date</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="varSymb" type="xs:integer">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Variabilní symbol</xs:documentation>
																	<xs:documentation xml:lang="EN">Reference #</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="volume" type="xs:decimal">
