						<xs:attribute name="ote" type="xs:boolean" use="required">
							<xs:annotation>
								<xs:documentation xml:lang="CS">Je-li nastaveno (1, true) jedna se o Podklady pro fakturaci OTE, v opacnem pripade (0, false) o Podklady pro fakturaci</xs:documentation>
								<xs:documentation xml:lang="EN">If set (1, true) OTE is on debet side, otherwise (0, false) OTE is on credit side</xs:documentation>
							</xs:annotation>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
				<xs:element ref="ds:Signature" minOccurs="0"/>
