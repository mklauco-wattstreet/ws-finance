																	<xs:documentation xml:lang="CS">Směnný kurz EUR</xs:documentation>
																	<xs:documentation xml:lang="EN">Exchange rate EUR</xs:documentation>
																</xs:annotation>
															</xs:attribute>
														</xs:complexType>
													</xs:element>
													<xs:element name="Summary">
														<xs:annotation>
															<xs:documentation xml:lang="CS">Sumární hodnoty</xs:documentation>
															<xs:documentation xml:lang="EN">Summary</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:attribute name="origAmountCzk" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Částka s daní</xs:documentation>
																	<xs:documentation xml:lang="EN">The amount with tax</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="origAmountEur" type="xs:decimal">
