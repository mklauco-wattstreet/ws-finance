																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="origAmountNetEur" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Částka bez DPH</xs:documentation>
																	<xs:documentation xml:lang="EN">The amount without VAT</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="origEtaxCzk" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Daň z elektřiny</xs:documentation>
																	<xs:documentation xml:lang="EN">The electricity tax</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="origEtaxEur" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Daň z elektřiny</xs:documentation>
																	<xs:documentation xml:lang="EN">The electricity tax</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="origVatCzk" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">DPH</xs:documentation>
																	<xs:documentation xml:lang="EN">VAT</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="origVatEur" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">DPH</xs:documentation>
																	<xs:documentation xml:lang="EN">VAT</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="paymentCzk" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Platba</xs:documentation>
																	<xs:documentation xml:lang="EN">Payment</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="paymentEur" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Platba</xs:documentation>
																	<xs:documentation xml:lang="EN">Payment</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="volume" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Množství</xs:documentation>
																	<xs:documentation xml:lang="EN">Volume</xs:documentation>
																</xs:annotation>
															</xs:attribute>
														</xs:complexType>
													</xs:element>
												</xs:sequence>
												<xs:attribute name="curr" use="required">
													<xs:annotation>
														<xs:documentation xml:lang="CS">Měna zúčtování</xs:documentation>
														<xs:documentation xml:lang="EN">The settlement currency</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="CZK"/>
															<xs:enumeration value="EUR"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="tradeType" use="required">
													<xs:annotation>
														<xs:documentation xml:lang="CS">
                                                Typ obchodu 
                                                 DT - denní trh,
                                                 DM- - denní trh - odběr,
                                                 DM+ - denní trh - dodávka,
                                                 VD+ - VDT dodávka,
                                                 VD- - VDT odběr,
                                                 BTD - Blokový trh - denní,
                                                 DE1 - Odchylky,
                                                 DE2 - Vícenáklady,
                                                 IEP - Kladné odchylky,
                                                 IEM - Záporné odchylky
                                                 AC+ - ACT dodávka
                                                 AC- - ACT nedodávka
                                                 PSK - Agregovaná RE
                                                 PP1 - Popl. za služby
                                                 PP2 - Popl. za spotřebu
                                                 PP3 - Popl. za zobchod. en.
                                                 PP4 - Popl. za CDS
                                                 PP5 - Popl. za VD trh
                                                 PP6 - Popl. za vyrovnávací trh
                                                 PP7 - Popl. za obchod. na BT
                                                 PP8 - Popl. za doplnění FZ
                                                 EMD - Vypořádání stavu nouze z koord. DT
                                                 DSK - DT export-import
                                                 DS- - DT export-import – odběr
                                                 DS+ - DT export-import - dodávka
                                                 PRF - Platba za profil - služby z řízení úzkého místa
                                                 SD- - Shipping na DT – odběr
                                                 SD+ - Shipping na DT - dodávka
                                                 R01 - Fixní poplatek REMIT
                                                 R02 - Poplatek REMIT reporting – transakce
                                                 R03 - Poplatek REMIT reporting – příkaz
                                                 VT+ - Dodávka RE+ z VT
                                                 VT- - Dodávka RE- z VT
                                                 SV- Shipping na VDT – odběr
                                                 SV+ Shipping na VDT – dodávka
                                                 TR+ - Dodávka RE+ z TERRE
                                                 TR-  Dodávka RE- z TERRE

                                                 PC-	Dodávka RE- z PICASSO
													PC+	Dodávka RE+ z PICASSO
													MA-	Dodávka RE- z MARI s plánovanou aktivací
													MA+	Dodávka RE+ z MARI s plánovanou aktivací
													MR-	Dodávka RE- MARI s přímou aktivací
													MR+	Dodávka RE- MARI s přímou aktivací
												 DA+ - Vnitrodenní aukce - dodávka
												 DA- - Vnitrodenní aukce - odběr
												 SA+ - Shipping na IDA - dodávka
												 SA- - Shipping na IDA – odběr  
												 PP9     Popl. zavnitrodenní aukce    

       </xs:documentation>
														<xs:documentation xml:lang="EN">
                                                Trade type 
                                                 DT - Day-ahead market,
                                                 DM- - Day-ahead market - consumption,
                                                 DM+ - Day-ahead market - supply,
                                                 VD+ - IM supply,
                                                 VD- - IM consumption,
                                                 BTD - Block market,
                                                 DE1 - Imbalance,
                                                 DE2 - Additional costs,
                                                 IEP - Positive imbalance,
                                                 IEM - Negative imbalance
                                                 AC+ - ACT - Positive relating energy
                                                 AC- - ACT - Negative relating energy
                                                 PSK - Agregated RE
                                                 PP1 - Fees - services
                                                 PP2 - Fees - consumption
                                                 PP3 - Fees - trading day
                                                 PP4 - Fees - CDS
                                                 PP5 - Fees - IM
                                                 PP6 - Fees - BM
                                                 PP7 - Fee for BM
                                                 PP8 - Fee for compensation
                                                 EMD - Settlement of emergency from Day-ahead market CZ-SK
                                                 DSK - DT export-import
                                                 DS- - DT export-import - consumption
                                                 DS+ - DT export-import - supply
                                                 PRF - Settlement for PRF
                                                 SD- - Shipping on DM – consumption
                                                 SD+ - Shipping on DM - supply
                                                 R01 - REMIT fixed fee
                                                 R02 - REMIT transaction fee
                                                 R03 - REMIT order fee
                                                 VT+ - Positive RE from BalM
                                                 VT- - Negative RE from BalM
                                                 SV- Shipping on IM - consumption
                                                 SV+ Shipping on IM - supply
                                                 TR+ - Positive RE from TERRE
												 TR-  Negative RE from TERRE
												 DA+ - Intraday auction - delivery
													DA- - Intraday auction - collection
													SA+ - Shipping to IDA - delivery
													SA- - Shipping to IDA - collection
													PP9 Fees - IDA
                                                        </xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="DT"/>
															<xs:enumeration value="DM-"/>
															<xs:enumeration value="DM+"/>
															<xs:enumeration value="VD+"/>
															<xs:enumeration value="VD-"/>
															<xs:enumeration value="BTD"/>
															<xs:enumeration value="DE1"/>
															<xs:enumeration value="DE2"/>
															<xs:enumeration value="IEP"/>
															<xs:enumeration value="IEM"/>
															<xs:enumeration value="AC+"/>
															<xs:enumeration value="AC-"/>
															<xs:enumeration value="PSK"/>
															<xs:enumeration value="PP1"/>
															<xs:enumeration value="PP2"/>
															<xs:enumeration value="PP3"/>
															<xs:enumeration value="PP4"/>
															<xs:enumeration value="PP5"/>
															<xs:enumeration value="PP6"/>
															<xs:enumeration value="PP7"/>
															<xs:enumeration value="PP8"/>
															<xs:enumeration value="EMD"/>
															<xs:enumeration value="DSK"/>
															<xs:enumeration value="PRF"/>
															<xs:enumeration value="SD-"/>
															<xs:enumeration value="SD+"/>
															<xs:enumeration value="R01"/>
															<xs:enumeration value="R02"/>
															<xs:enumeration value="R03"/>
															<xs:enumeration value="VT+"/>
															<xs:enumeration value="VT-"/>
															<xs:enumeration value="SV-"/>
															<xs:enumeration value="SV+"/>
															<xs:enumeration value="TR+"/>
															<xs:enumeration value="TR-"/>
															<xs:enumeration value="PC-"/>
															<xs:enumeration value="PC+"/>
															<xs:enumeration value="MA-"/>
															<xs:enumeration value="MA+"/>
															<xs:enumeration value="MR-"/>
															<xs:enumeration value="MR+"/>
															<xs:enumeration value="DA+"/>
															<xs:enumeration value="DA-"/>
															<xs:enumeration value="SA+"/>
															<xs:enumeration value="SA-"/>
															<xs:enumeration value="PP9"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="version" use="required">
													<xs:annotation>
														<xs:documentation xml:lang="CS">Typ zúčtování (0 zálohy, 1 platby)</xs:documentation>
														<xs:documentation xml:lang="EN">Settlement type (0 daily, 1 monthly)</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:integer">
															<xs:enumeration value="0"/>
															<xs:enumeration value="1"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
