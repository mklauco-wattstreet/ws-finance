																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="origAmountEur" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Částka s daní</xs:documentation>
																	<xs:documentation xml:lang="EN">The amount with tax</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="origAmountNetCzk" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Částka bez DPH</xs:documentation>
																	<xs:documentation xml:lang="EN">The amount without VAT</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="origAmountNetEur" type="xs:decimal">
																<xs:annotation>
																	<xs:documentation xml:lang="CS">Částka bez DPH</xs:documentation>
																	<xs:documentation xml:lang="EN">The amount without VAT</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="origEtaxCzk" type="xs:decimal">
